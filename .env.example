MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=interview_prep

# Dev stand-in for real auth. Unset DEV_USER_ID to exercise signed-out.
# Used whenever AUTH_GITHUB_ID / AUTH_GITHUB_SECRET below are not set.
# Never set these on a public deployment: a production build ignores them
# anyway (everyone is signed out) unless ALLOW_DEV_AUTH=1 is also set.
DEV_USER_ID=founder
DEV_USER_ROLE=admin

# Real accounts (Stage 4), via GitHub OAuth. Optional locally — leave unset
# and the app keeps using DEV_USER_ID above. To turn this on:
#   1. https://github.com/settings/developers -> New OAuth App
#      Homepage URL:             http://localhost:3000  (or your real domain)
#      Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   2. Copy the generated Client ID and Client Secret below.
#   3. AUTH_SECRET: any random 32+ byte string, e.g. `openssl rand -base64 33`.
#   4. ADMIN_GITHUB_LOGINS: comma-separated GitHub usernames that should sign
#      in as admin. Everyone else who signs in becomes a plain 'user'.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_SECRET=
# ADMIN_GITHUB_LOGINS=your-github-username
